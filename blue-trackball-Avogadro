def trackball_pymol():
    """
    Read 3D trackball movements and send camera position updates to pymol.
    If needed, inject the helper procedure there. Both pymol and this code
    can start/stop at will and connection just works.
    """
    #pymol_socket.do(intro_hack)


    stereo_on = False # we just suppose


    pymol_connection_status = "did not try yet"
    for kind, t, *rest in trackball_xyz():
        if kind=="button_press":
            print("Toggle stereo")
            try:
                if stereo_on:
                    pymol_socket.do("stereo off")
                    stereo_on = False
                else:
                    pymol_socket.do("stereo anaglyph")
                    stereo_on = True
            except:
                print('Failed to send stereo toggle, no "pymol -R" running?')
            continue

        dx, dy, dz, dw = rest[0]
        dx, dy, dz = -dy*0.085, dz*0.085, -dx*0.085 # map between ball and pymol coordinates


        deliver_xyzw(dx, dy, dz, dw) # deliver to pymol or Avogadro

        try:
            pymol_socket.turn_xyzw(dx, dy, dz, dw)
            if pymol_connection_status != "OK":
                print("Connection for XYZW deltas to pymol works even without code inject")
                pymol_connection_status = "OK"
        except:
            print("Failed to send XYZW deltas to pymol")
            pymol_connection_status = "failed XYZW"
            try:
                pymol_socket.do(intro_hack)
                print("Injected XYZ receiver into pymol")
                pymol_socket.turn_xyz(dx, dy, dz) # try again
                print("Established working connection for XYZW deltas to pymol")
                pymol_connection_status = "OK"
            except:
